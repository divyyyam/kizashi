# kizashi-web: the Next.js UI (apps/web). Build context is the repo root:
#   docker build -f deploy/Dockerfile.web -t kizashi-web .
# NEXT_PUBLIC_* values are inlined at build time, so pass them as build args (the compose file does).
FROM oven/bun:1.4.2-slim AS build
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY package.json bun.lock turbo.json ./
COPY apps/web/package.json apps/web/
COPY apps/engine/package.json apps/engine/
COPY apps/indexer/package.json apps/indexer/
COPY packages/arkiv/package.json packages/arkiv/
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY packages/schemas/package.json packages/schemas/
COPY packages/swarm/package.json packages/swarm/
RUN bun install --frozen-lockfile --ignore-scripts --filter @kizashi/web

COPY apps/web apps/web
COPY packages packages
COPY contracts/deployments contracts/deployments
RUN mkdir -p node_modules/@kizashi && ln -sfn ../../packages/config node_modules/@kizashi/config

ARG NEXT_PUBLIC_CHAIN_ID
ARG NEXT_PUBLIC_ARC_RPC_URL
ARG NEXT_PUBLIC_ENGINE_URL
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ARG NEXT_PUBLIC_ARKIV_LISTING_WRITER
ARG NEXT_PUBLIC_ARKIV_INDEXER_WRITER
ARG NEXT_PUBLIC_ARKIV_ENGINE_WRITER
ENV NEXT_OUTPUT=standalone NEXT_TELEMETRY_DISABLED=1
RUN bunx turbo run build --filter=@kizashi/web

FROM node:22-slim AS runtime
WORKDIR /app
ARG GIT_SHA=dev
LABEL org.opencontainers.image.revision=$GIT_SHA
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1 GIT_SHA=$GIT_SHA
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static apps/web/.next/static
COPY --from=build --chown=node:node /app/apps/web/public apps/web/public
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3000/ -o /dev/null || exit 1
CMD ["node", "apps/web/server.js"]
