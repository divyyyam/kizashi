# kizashi-api: the engine and HTTP API (apps/engine). Build context is the repo root:
#   docker build -f deploy/Dockerfile.api -t kizashi-api .
FROM oven/bun:1.4.2-slim AS build
WORKDIR /app
# Debian slim ships no OpenSSL or CA bundle; Prisma and TLS to the hosted database need them.
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Manifests first so the dependency layer is cached until a lockfile or package.json changes.
COPY package.json bun.lock ./
COPY apps/engine/package.json apps/engine/
COPY apps/indexer/package.json apps/indexer/
COPY apps/web/package.json apps/web/
COPY packages/arkiv/package.json packages/arkiv/
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY packages/schemas/package.json packages/schemas/
COPY packages/swarm/package.json packages/swarm/
RUN bun install --frozen-lockfile --ignore-scripts \
    --filter @kizashi/engine --filter @kizashi/db

COPY apps/engine apps/engine
COPY packages/arkiv packages/arkiv
COPY packages/config packages/config
COPY packages/core packages/core
COPY packages/db packages/db
COPY packages/schemas packages/schemas
# Prisma 7 with the bun runtime and the pg adapter has no native query engine, so no
# binaryTargets are needed; generation only needs the schema, not a database.
RUN cd packages/db && bunx prisma generate

FROM oven/bun:1.4.2-slim AS runtime
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production PORT=8787
COPY --from=build --chown=bun:bun /app /app
USER bun
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${PORT}/health" || exit 1
CMD ["bun", "apps/engine/src/index.ts"]
