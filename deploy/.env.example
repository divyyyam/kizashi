# Copy to /opt/kizashi/.env on the server, chmod 600. Never commit real values.

# --- api (apps/engine) ---
# Hosted Prisma Postgres connection string.
DATABASE_URL=
ENGINE_DB_SCHEMA=kizashi_engine
ENGINE_CHECKPOINT_SCHEMA=kizashi_checkpoints
# At least 32 bytes of randomness (openssl rand -base64 48).
ENGINE_JWT_SECRET=
# Comma-separated browser origins allowed to call the API.
ENGINE_ALLOWED_ORIGINS=https://kizashi.space
# Host of one allowed origin, used as the SIWE domain.
ENGINE_SIWE_DOMAIN=kizashi.space
NEXT_PUBLIC_CHAIN_ID=5042002
ARC_TESTNET_RPC_URL=
GOOGLE_GENERATIVE_AI_API_KEY=
ENGINE_GEMINI_MODEL=gemini-3.5-flash-lite
# Arkiv proposal publishing (optional; the engine runs without it).
ENGINE_ARKIV_PRIVATE_KEY=
ARKIV_RPC_URL=
ARKIV_WS_URL=
ARKIV_CHAIN_ID=7794095
# PORT and NODE_ENV are set by deploy/docker-compose.yml.

# --- image selection (read by compose from the shell or a .env next to the compose file) ---
# KIZASHI_IMAGE=docker.io/<namespace>/kizashi-api:latest
