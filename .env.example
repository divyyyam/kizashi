# Web settlement chain ID: 31337 locally, 5042002 on Arc testnet.
NEXT_PUBLIC_CHAIN_ID=31337
# Public Arc testnet HTTP RPC endpoint.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
# WalletConnect project ID, required when the wallet lane is enabled.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Phase 2 engine HTTP origin; deployed at https://api.kizashi.space.
NEXT_PUBLIC_ENGINE_URL=
# Phase 2 indexer HTTP base; deployed at https://api.kizashi.space/indexer.
NEXT_PUBLIC_INDEXER_URL=
# Contracts deployment HTTP RPC endpoint for Arc testnet.
ARC_TESTNET_RPC_URL=
# Contracts deployer private key from a fresh wallet; secret.
DEPLOYER_PRIVATE_KEY=
# Phase 2 Prisma Postgres connection string (sslmode=require) for engine and indexer; schemas separate them; secret.
DATABASE_URL=
# Engine app-table schema; empty uses the dev default, deployed sets e.g. engine.
ENGINE_DB_SCHEMA=
# Engine LangGraph checkpoint schema; empty uses the dev default, deployed sets e.g. engine_checkpoints.
ENGINE_CHECKPOINT_SCHEMA=
# Phase 2 engine transaction key from a fresh wallet; secret.
ENGINE_PRIVATE_KEY=
# Phase 2 Gemini API key passed explicitly by the engine; secret.
GOOGLE_GENERATIVE_AI_API_KEY=
# Phase 2 engine bearer-token signing secret.
ENGINE_JWT_SECRET=
# Phase 2 allowed web origins, including https://kizashi.space when deployed.
ENGINE_ALLOWED_ORIGINS=
# Phase 2 expected SIWE domain for wallet sign-in, kizashi.space when deployed.
ENGINE_SIWE_DOMAIN=
# Optional phase 2 LangSmith tracing switch.
LANGSMITH_TRACING=
# Optional phase 2 LangSmith API key; secret.
LANGSMITH_API_KEY=
# Arkiv HTTP RPC endpoint; verified by ARK-01.
ARKIV_RPC_URL=
# Arkiv WebSocket endpoint; verified by ARK-01.
ARKIV_WS_URL=
# Arkiv integer chain ID; verified by ARK-01.
ARKIV_CHAIN_ID=
# Phase 2 engine Arkiv writer key from a fresh wallet; secret.
ENGINE_ARKIV_PRIVATE_KEY=
# Phase 2 indexer Arkiv writer key from a fresh wallet; secret.
INDEXER_ARKIV_PRIVATE_KEY=
# Public Arkiv HTTP endpoint for discovery, history and inbox reads.
NEXT_PUBLIC_ARKIV_RPC_URL=
# Public Arkiv WebSocket endpoint for live reads.
NEXT_PUBLIC_ARKIV_WS_URL=
# Server-only Swarm Bee endpoint for uploads; supplied at D11.
SWARM_BEE_URL=
# Server-only Swarm postage batch ID; supplied at D11.
SWARM_POSTAGE_BATCH_ID=
# Public Swarm gateway for rules and resolution evidence reads.
NEXT_PUBLIC_SWARM_GATEWAY_URL=
# Phase 2 Ponder HTTP RPC endpoint for Arc chain 5042002.
PONDER_RPC_URL_5042002=
# Phase 2 Ponder schema name in the shared hosted Postgres instance.
DATABASE_SCHEMA=

# WSL file watching: poll for edits made by Windows-side editors.
# Next.js Watchpack polling switch for local development.
WATCHPACK_POLLING=true
# Chokidar polling switch for local development.
CHOKIDAR_USEPOLLING=true
