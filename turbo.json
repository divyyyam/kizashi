{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "env": ["NEXT_PUBLIC_*", "WATCHPACK_POLLING", "CHOKIDAR_USEPOLLING"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "codegen": {
      "inputs": ["../../contracts/out/**", "../../contracts/deployments/**"],
      "outputs": ["src/generated.ts"]
    }
  }
}
