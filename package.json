{
  "name": "kizashi",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "bun run lint && turbo run typecheck test build",
    "codegen": "turbo run codegen --filter=@kizashi/contracts",
    "forge:build": "cd contracts && forge build",
    "forge:test": "cd contracts && forge test",
    "dev:local": "bun scripts/dev-local.ts",
    "anvil": "anvil --chain-id 31337 --block-time 1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@kizashi/config": "workspace:*",
    "@types/bun": "1.4.4",
    "lefthook": "2.2.2",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
